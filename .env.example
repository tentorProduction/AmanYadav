# Local development secrets — never commit.
# Rename to .env.local and fill in real values.

# Resend (https://resend.com/api-keys) — required for the /contact form to deliver.
RESEND_API_KEY=re_your_key_here

# Inbox that should receive contact-form messages.
CONTACT_TO_EMAIL=hello@amanyadav.dev

# Verified sender on your Resend account.
CONTACT_FROM_EMAIL=Aman Portfolio <onboarding@resend.dev>

# Canonical origin used for SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://amanyadav.dev
